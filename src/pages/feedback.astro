  </div>
</Base>

<script>
  {
    const form = document.getElementById('feedback-form') as HTMLFormElement;
    const description = document.getElementById('description') as HTMLTextAreaElement;
    const descriptionError = document.getElementById('description-error') as HTMLElement;
    const status = document.getElementById('form-status') as HTMLElement;

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      const valid = description.value.trim().length > 0;
      descriptionError.hidden = valid;
      description.setAttribute('aria-invalid', String(!valid));
      if (!valid) {
        description.focus();
        return;
      }

      // Netlify Forms accepts a URL-encoded POST to any path on the site,
      // as long as the body carries the form-name field.
      const params = new URLSearchParams();
      new FormData(form).forEach((value, key) => params.append(key, value as string));

      try {
        const response = await fetch('/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: params.toString(),
        });
        if (!response.ok) throw new Error(String(response.status));
        form.reset();
        status.hidden = false;
        status.className = 'mt-3 mb-0 text-sm text-ink-muted';
        status.textContent = 'Thanks — your message is on its way.';
      } catch {
        status.hidden = false;
        status.className = 'mt-3 mb-0 text-sm text-destructive';
        status.textContent =
          'Something went wrong sending that — please try again in a moment.';
      }
    });
  }
</script>
